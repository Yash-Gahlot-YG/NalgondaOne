# NalgondaOne Client Environment Variables
# Expo automatically exposes variables starting with EXPO_PUBLIC_ to the client bundle.

# Backend API URL (Defaults to Render backend deployment URL):
EXPO_PUBLIC_API_URL=https://nalgondaone.onrender.com

# Google Maps API Key (Optional for basic embed, recommended for production high-volume usage)
# 1. Create a Maps Embed API key in Google Cloud Console: https://console.cloud.google.com/
# 2. Restrict the key to "HTTP referrers (web sites)" such as:
#    - http://localhost:8081/*
#    - https://*.yourproductiondomain.com/*
# 3. Restrict API scope to: "Maps Embed API"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

