NODE_ENV=development
PORT=5000

# CORS Allowed Origins (comma-separated list for production domains)
# Example: CORS_ORIGIN=https://nalgondaone.com,https://admin.nalgondaone.com
CORS_ORIGIN=

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=NalgondaOne-Cluster

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-prod
JWT_EXPIRES_IN=7d

# Admin Seed Credentials
SUPER_ADMIN_NAME=Yash Gahlot
SUPER_ADMIN_EMAIL=yash@nalgondaone.com
SUPER_ADMIN_PASSWORD=your-super-admin-password

ADMIN_NAME=Admin Dev
ADMIN_EMAIL=admin@nalgondaone.com
ADMIN_PASSWORD=your-admin-password

# Cloudinary Cloud Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
